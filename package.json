{
  "name": "vox-folio",
  "version": "0.1.0",
  "description": "Audiobookshelf player for LG webOS TVs",
  "author": "Odd Orbit Software Group",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/index.tsx",
  "scripts": {
    "serve": "enact serve",
    "pack": "enact pack",
    "pack-p": "enact pack -p",
    "clean": "enact clean",
    "lint": "enact lint .",
    "test": "enact test",
    "typecheck": "tsc --noEmit",
    "check-es": "node tools/check-es.mjs dist",
    "build": "enact pack -p && node tools/check-es.mjs dist",
    "package": "npm run build && ares-package dist -o build"
  },
  "enact": {
    "title": "Vox Folio",
    "template": "public/index.ejs",
    "ri": false
  },
  "browserslist": [
    "chrome 79"
  ],
  "dependencies": {
    "@enact/core": "5.7.0",
    "@enact/spotlight": "5.7.0",
    "@enact/ui": "5.7.0",
    "@enact/webos": "5.7.0",
    "@fontsource/figtree": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@enact/cli": "7.4.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "acorn": "8.19.0",
    "typescript": "5.9.3"
  }
}
